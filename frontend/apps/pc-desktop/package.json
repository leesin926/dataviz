{
  "name": "@dataviz/pc-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "DataViz 可视化大屏桌面端（多窗口、离线大屏、导出、自动更新）",
  "author": "DataViz Team",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:3300 && electron .\"",
    "build": "vue-tsc --noEmit && vite build",
    "build:electron": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.7",
    "vue-i18n": "^11.0.0",
    "element-plus": "^2.6.1",
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.6.7",
    "echarts": "^5.5.0",
    "@dataviz/shared-types": "workspace:*",
    "@dataviz/shared-utils": "workspace:*",
    "@dataviz/shared-styles": "workspace:*",
    "@dataviz/screen-engine": "workspace:*",
    "@dataviz/api-client": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "vite": "^5.1.5",
    "sass": "^1.71.1",
    "typescript": "^5.3.3",
    "vue-tsc": "^2.0.6",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "concurrently": "^8.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.dataviz.desktop",
    "productName": "DataViz Desktop",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/node_modules/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DataViz 桌面端",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://REPLACE-WITH-INTRANET-UPDATE-HOST/updates/win32"
      }
    ]
  }
}
