<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dataviz.user.mapper.RoleMapper">

    <delete id="deletePermissionsByRoleId">
        DELETE FROM sys_role_permission WHERE role_id = #{roleId}
    </delete>

    <insert id="insertBatchRolePermissions">
        INSERT INTO sys_role_permission (role_id, permission_id) VALUES
        <foreach collection="permissionIds" item="permissionId" separator=",">
            (#{roleId}, #{permissionId})
        </foreach>
    </insert>

    <!-- 口径与 selectUsernamesByRoleId 保持一致：join 用户表只滤 deleted，不滤 status（停用账号仍然挂在这个角色上）。 -->
    <select id="countMembersByRoleId" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM sys_user_role ur
        INNER JOIN sys_user u ON u.id = ur.user_id
        WHERE ur.role_id = #{roleId}
          AND u.deleted = 0
    </select>

</mapper>
