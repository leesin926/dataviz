INSERT INTO model_dataset (id, tenant_id, name, datasource_id, table_name, sql_query, dimensions, metrics, filters, create_by, deleted) VALUES (919, 1, '门店目标达成（跨库关联）', 901, NULL, 'SELECT s.store_name, s.region, s.city, MAX(s.monthly_target) AS target_amount, SUM(t.amount) AS amount, SUM(t.profit) AS profit, ROUND(SUM(t.amount) / NULLIF(MAX(s.monthly_target), 0) * 100, 2) AS achievement_rate, ROUND(SUM(t.profit) / NULLIF(SUM(t.amount), 0) * 100, 2) AS margin_rate FROM db_model.demo_stores s JOIN db_analysis.dws_store_sales t ON t.store_id = s.store_id GROUP BY s.store_name, s.region, s.city', '[{"field":"store_name","displayName":"门店","type":"category"},{"field":"region","displayName":"大区","type":"category"},{"field":"city","displayName":"城市","type":"category"}]', '[{"field":"target_amount","displayName":"月度目标","aggregation":"sum","format":"#,##0.00"},{"field":"amount","displayName":"销售额","aggregation":"sum","format":"#,##0.00"},{"field":"profit","displayName":"毛利","aggregation":"sum","format":"#,##0.00"},{"field":"achievement_rate","displayName":"达成率","aggregation":"avg","format":"0.00"},{"field":"margin_rate","displayName":"毛利率","aggregation":"avg","format":"0.00"}]', '[]', 'admin', 0)
--------------

