@@MD ~|~ 919 ~|~ 901 ~|~ NULL ~|~ SELECT s.store_name, s.region, s.city, MAX(s.monthly_target) AS target_amount, SUM(t.amount) AS amount, SUM(t.profit) AS profit, ROUND(SUM(t.amount) / NULLIF(MAX(s.monthly_target), 0) * 100, 2) AS achievement_rate, ROUND(SUM(t.profit) / NULLIF(SUM(t.amount), 0) * 100, 2) AS margin_rate FROM db_model.demo_stores s JOIN db_analysis.dws_store_sales t ON t.store_id = s.store_id GROUP BY s.store_name, s.region, s.city ~|~ [{"field":"store_name","displayName":"门店","type":"category"},{"field":"region","displayName":"大区","type":"category"},{"field":"city","displayName":"城市","type":"category"}] ~|~ [{"field":"target_amount","displayName":"月度目标","aggregation":"sum","format":"#,##0.00"},{"field":"amount","displayName":"销售额","aggregation":"sum","format":"#,##0.00"},{"field":"profit","displayName":"毛利","aggregation":"sum","format":"#,##0.00"},{"field":"achievement_rate","displayName":"达成率","aggregation":"avg","format":"0.00"},{"field":"margin_rate","displayName":"毛利率","aggregation":"avg","format":"0.00"}] ~|~ []
@@MD ~|~ 920 ~|~ 901 ~|~ NULL ~|~ SELECT channel, category, SUM(amount) AS amount, SUM(profit) AS profit, SUM(order_count) AS order_count, ROUND(SUM(profit) / NULLIF(SUM(amount), 0) * 100, 2) AS margin_rate FROM dwd_sales_daily GROUP BY channel, category ~|~ [{"field":"channel","displayName":"渠道","type":"category"},{"field":"category","displayName":"商品类目","type":"category"}] ~|~ [{"field":"amount","displayName":"销售额","aggregation":"sum","format":"#,##0.00"},{"field":"profit","displayName":"毛利","aggregation":"sum","format":"#,##0.00"},{"field":"order_count","displayName":"订单量","aggregation":"sum","format":"#,##0"},{"field":"margin_rate","displayName":"毛利率","aggregation":"avg","format":"0.00"}] ~|~ []
@@MD ~|~ 921 ~|~ 901 ~|~ NULL ~|~ SELECT stat_date, SUM(amount) AS amount, SUM(profit) AS profit, SUM(order_count) AS order_count, SUM(qty) AS qty, ROUND(SUM(profit) / NULLIF(SUM(amount), 0) * 100, 2) AS margin_rate FROM dwd_sales_daily GROUP BY stat_date ~|~ [{"field":"stat_date","displayName":"统计日期","type":"time","format":"yyyy-MM-dd"}] ~|~ [{"field":"amount","displayName":"销售额","aggregation":"sum","format":"#,##0.00"},{"field":"profit","displayName":"毛利","aggregation":"sum","format":"#,##0.00"},{"field":"order_count","displayName":"订单量","aggregation":"sum","format":"#,##0"},{"field":"qty","displayName":"件数","aggregation":"sum","format":"#,##0"},{"field":"margin_rate","displayName":"毛利率","aggregation":"avg","format":"0.00"}] ~|~ []
