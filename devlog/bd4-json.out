@@R 902 CFG {"dimensions":[{"field":"event_type"}],"metrics":[{"field":"duration_ms","aggFunction":"AVG","alias":"avg_duration"}]}
@@R 903 CFG {"dimensions":[{"field":"status"}],"metrics":[{"field":"pay_amount","aggFunction":"SUM","alias":"pay_amount"}]}
